{
  "name": "wms-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,api -c blue,green \"vite\" \"npm run server\"",
    "server": "json-server --watch db.json --port 3000 -m ./node_modules/json-server-auth",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "format": "prettier --write src",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@tailwindcss/vite": "^4.3.3",
    "json-server": "^0.17.4",
    "json-server-auth": "^2.1.0",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.90.0",
    "react-router": "^8.4.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
